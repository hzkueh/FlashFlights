{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "Data Source=identity.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "CorsPolicy": "spa",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "ordering": {
        "ClusterId": "ordering",
        "CorsPolicy": "spa",
        "Match": { "Path": "/api/ordering/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/ordering" } ]
      },
      "notifications": {
        "ClusterId": "notifications",
        "CorsPolicy": "spa",
        "Match": { "Path": "/api/notifications/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/notifications" } ]
      },
      // Everything that is not an API call is the SPA's own routing, so the
      // gateway is the single entry point a reviewer opens. Ordered last
      // explicitly rather than relying on the catch-all being least specific.
      "web": {
        "ClusterId": "web",
        "Order": 100,
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": { "Address": "http://localhost:8081/" }
        }
      },
      "ordering": {
        "Destinations": {
          "primary": { "Address": "http://localhost:8082/" }
        }
      },
      "notifications": {
        "Destinations": {
          "primary": { "Address": "http://localhost:8083/" }
        }
      },
      // Outside compose this is the Vite dev server, so the gateway fronts the
      // SPA in local development too. docker-compose points it at nginx.
      "web": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5173/" }
        }
      }
    }
  }
}
