{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Signed with by the gateway, validated against by every service, so all four
  // hosts must agree on it. Development only, and deliberately absent from
  // appsettings.json: a host with no key configured refuses to start rather
  // than trusting a default that is public in this repo. docker-compose.yml
  // overrides all four from one anchor.
  "Jwt": {
    "SigningKey": "flashflights-local-development-signing-key-not-for-production"
  }
}
